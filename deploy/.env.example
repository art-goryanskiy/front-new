# Образ бэкенда (собранный из репо бэкенда и запушенный в registry)
BACKEND_IMAGE=ghcr.io/your-org/education-center-app:latest

# Образ фронта (собирается GitHub Actions из репо front-new)
FRONT_IMAGE=ghcr.io/your-org/front-new
# Тег подставляет workflow: latest для main, имя ветки для develop и др.
FRONT_IMAGE_TAG=latest
