# Бэкенд (продакшен)
# GraphQL API — все запросы идут на этот URL (POST /graphql)
NEXT_PUBLIC_GRAPHQL_URL=https://www.new.standart82.ru/graphql

# Загрузка изображений (REST POST multipart)
NEXT_PUBLIC_UPLOAD_URL=https://www.new.standart82.ru/upload/image

# URL фронта для SEO (canonical, OpenGraph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://www.new.standart82.ru

# T-Bank EACQ (оплата картой): TerminalKey для Integration.js на фронте (виджет/iframe)
# Пароль терминала — только на бэкенде, не добавлять в NEXT_PUBLIC_
# NEXT_PUBLIC_TBANK_TERMINAL_KEY=your_terminal_key

# Для локальной разработки с локальным бэкендом раскомментируйте:
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4200/graphql
# NEXT_PUBLIC_UPLOAD_URL=http://localhost:3000/upload/image
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP (форма обратной связи на /contacts)
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=info@standart82.ru
SMTP_PASS=your_smtp_password
SMTP_FROM=info@standart82.ru
